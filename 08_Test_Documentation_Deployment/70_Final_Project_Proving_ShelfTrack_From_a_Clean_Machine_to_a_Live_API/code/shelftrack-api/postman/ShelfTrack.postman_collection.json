{
  "info": {
    "name": "ShelfTrack API — Acceptance Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"healthy\",()=>pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().status).to.eql(\"ok\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Create book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Practical Node Systems\",\n  \"isbn\": \"978{{$timestamp}}\",\n  \"authors\": [\n    \"Ada Rivers\"\n  ],\n  \"category\": \"software\",\n  \"publishedYear\": 2026,\n  \"totalCopies\": 3,\n  \"shelf\": {\n    \"floor\": 1,\n    \"code\": \"A-10\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"created\",()=>pm.response.to.have.status(201));",
              "const b=pm.response.json(); pm.environment.set(\"bookId\",b.data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books?page=1&limit=20&q=Node",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "q",
              "value": "Node"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"ok\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get book",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books",
            "{{bookId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"ok\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Patch book",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books",
            "{{bookId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shelf\": {\n    \"floor\": 3,\n    \"code\": \"C-12\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"updated\",()=>pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data.shelf.code).to.eql(\"C-12\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": 42,\n  \"isbn\": true,\n  \"totalCopies\": \"3\",\n  \"unexpectedAdminFlag\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invalid body is rejected\",()=>pm.response.to.have.status(400));",
              "const body=pm.response.json();",
              "pm.expect(body.error.code).to.eql(\"VALIDATION_ERROR\");",
              "pm.expect(body.error.details).to.be.an(\"array\");"
            ]
          }
        }
      ]
    },
